{
  "name": "computer-use-automation-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "demo": "tsx src/cli.ts",
    "start:target": "tsx demo/legacy-bank/server.ts",
    "record:video": "tsx demo/record-video.ts",
    "narrate:video": "powershell -NoProfile -ExecutionPolicy Bypass -File demo/add-narration.ps1"
  },
  "dependencies": {
    "@playwright/test": "1.62.1",
    "commander": "14.0.0",
    "express": "5.1.0",
    "openai": "5.16.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "ajv": "8.20.0",
    "eslint": "9.34.0",
    "ffmpeg-static": "5.2.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.7"
  }
}
