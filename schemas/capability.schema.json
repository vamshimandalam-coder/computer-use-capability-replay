{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/computer-use-capability-1.0.json",
  "title": "Computer-use capability 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability",
    "compatibility",
    "inputs",
    "outputs",
    "preconditions",
    "steps",
    "businessOutcomes",
    "recoveries",
    "escalation",
    "success",
    "redaction"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description", "lifecycle"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "lifecycle": { "enum": ["draft", "approved"] }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "application", "vendor", "versions", "tenantOverrides"],
      "properties": {
        "surface": { "const": "browser" },
        "application": { "type": "string" },
        "vendor": { "type": "string" },
        "versions": { "type": "array", "items": { "type": "string" } },
        "tenantOverrides": { "type": "object" }
      }
    },
    "inputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } },
    "outputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/output" } },
    "preconditions": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "businessOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "when"],
        "properties": { "code": { "type": "string" }, "when": { "$ref": "#/$defs/checkpoint" } }
      }
    },
    "recoveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "when", "action", "maxAttempts"],
        "properties": {
          "code": { "type": "string" },
          "when": { "$ref": "#/$defs/checkpoint" },
          "action": { "$ref": "#/$defs/step" },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "requestedAction"],
      "properties": {
        "on": { "type": "array", "items": { "type": "string" } },
        "requestedAction": { "type": "string" }
      }
    },
    "success": { "$ref": "#/$defs/checkpoint" },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputKeys", "outputKeys"],
      "properties": {
        "inputKeys": { "type": "array", "items": { "type": "string" } },
        "outputKeys": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required", "description", "sensitive"],
      "properties": {
        "type": { "enum": ["string", "number", "boolean"] },
        "required": { "type": "boolean" },
        "pattern": { "type": "string" },
        "description": { "type": "string" },
        "sensitive": { "type": "boolean" }
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "role", "name"],
          "properties": {
            "kind": { "const": "role" },
            "role": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label"],
          "properties": { "kind": { "const": "label" }, "label": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text", "exact"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string" },
            "exact": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "value"],
          "properties": {
            "kind": { "const": "attribute" },
            "name": { "type": "string" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector"],
          "properties": { "kind": { "const": "css" }, "selector": { "type": "string" } }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "description", "framePath", "locators"],
      "properties": {
        "surface": { "const": "browser" },
        "description": { "type": "string" },
        "framePath": { "type": "array", "items": { "type": "string" } },
        "locators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/locator" } }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "value"],
          "properties": { "source": { "const": "literal" }, "value": { "type": "string" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "key"],
          "properties": { "source": { "const": "input" }, "key": { "type": "string" } }
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expected"],
      "properties": {
        "kind": { "enum": ["url", "visibleText", "elementVisible"] },
        "expected": { "type": "string" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "risk", "waitMs"],
      "properties": {
        "id": { "type": "string" },
        "action": { "enum": ["navigate", "click", "fill", "select"] },
        "target": { "$ref": "#/$defs/target" },
        "value": { "$ref": "#/$defs/value" },
        "risk": { "enum": ["safe", "reversible", "risky", "irreversible"] },
        "waitMs": { "type": "integer", "minimum": 1, "maximum": 15000 },
        "checkpoint": { "$ref": "#/$defs/checkpoint" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description", "target", "transform"],
      "properties": {
        "type": { "enum": ["string", "number", "boolean"] },
        "description": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "transform": { "enum": ["text", "currency", "boolean"] }
      }
    }
  }
}
